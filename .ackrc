#
# ~/.ackrc
#

--pager=less -R
--smart-case
--sort-files

--ignore-directory=is:deps
--ignore-directory=is:vendor
--ignore-file=is:tags

--type-add=elixirtest:match:/(?-i)_test\.exs$/

--type-add=erlangtest:match:/(?-i)_SUITE\.erl$/
--type-add=erlangtest:match:/(?-i)_tests\.erl$/
--type-add=erlangtest:match:/(?-i)^prop_.*\.erl$/

--type-add=gettext:ext:po,pot
--type=nogettext

--type-add=gotest:match:/(?-i)_test\.go$/

--type-add=phptest:match:/(?-i)Test\.php$/

--type-add=rc:ext:rc
--type-add=rc:firstlinematch:/^#!.*\brc\b/

--type-add=thrift:ext:thrift

--type-add=twig:ext:twig
