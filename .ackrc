#
# ~/.ackrc
#

--ignore-file=is:tags
--pager=less -R
--smart-case
--sort-files

--type-add=po:ext:po,pot
--type-add=scss:ext:sass,scss
--type-add=thrift:ext:thrift
--type-add=twig:ext:twig

--type-add=erlangtest:match:/_SUITE\.erl$/
--type-add=erlangtest:match:/_tests\.erl$/
--type-add=erlangtest:match:/^prop_.*\.erl$/

--type-add=gotest:match:/_test\.go$/

--type-add=rc:ext:rc
--type-add=rc:firstlinematch:/^#!.*\brc\b/

--type=nopo
